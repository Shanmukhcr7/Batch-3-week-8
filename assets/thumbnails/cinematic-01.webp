<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1280 720" width="1280" height="720">
  <defs>
    <linearGradient id="bgGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#08090D"/>
      <stop offset="40%" stop-color="#171B3A"/>
      <stop offset="80%" stop-color="#08090D"/>
      <stop offset="100%" stop-color="#171B3A"/>
    </linearGradient>
    <radialGradient id="glowGrad" cx="50%" cy="40%" r="60%">
      <stop offset="0%" stop-color="#3B82F6" stop-opacity="0.5"/>
      <stop offset="50%" stop-color="#171B3A" stop-opacity="0.2"/>
      <stop offset="100%" stop-color="#000000" stop-opacity="0"/>
    </radialGradient>
    <filter id="blurFilter" x="-20%" y="-20%" width="140%" height="140%">
      <feGaussianBlur stdDeviation="60"/>
    </filter>
  </defs>

  <!-- Background -->
  <rect width="1280" height="720" fill="url(#bgGrad)"/>

  <!-- Ambient Glow -->
  <circle cx="640" cy="288" r="576" fill="url(#glowGrad)" filter="url(#blurFilter)"/>

  <!-- Geometric Abstract Elements -->
  <g opacity="0.6">
    <circle cx="640" cy="302.4" r="220" fill="none" stroke="#3B82F6" stroke-width="2" stroke-dasharray="8 6"/>
    <circle cx="640" cy="302.4" r="280" fill="none" stroke="#FFFFFF" stroke-opacity="0.15" stroke-width="1"/>
    <polygon points="640,158.4 921.5999999999999,374.40000000000003 358.40000000000003,374.40000000000003" fill="none" stroke="#171B3A" stroke-width="3" stroke-opacity="0.7"/>
    <rect x="486.4" y="216" width="307.2" height="307.2" fill="none" stroke="#FFFFFF" stroke-width="1.5" stroke-opacity="0.4" transform="rotate(45 640 302.4)"/>
  </g>

  <!-- Corner framing lines (Awwwards/cinematic style) -->
  <line x1="60" y1="60" x2="160" y2="60" stroke="#FFFFFF" stroke-opacity="0.4" stroke-width="2"/>
  <line x1="60" y1="60" x2="60" y2="160" stroke="#FFFFFF" stroke-opacity="0.4" stroke-width="2"/>
  <line x1="1220" y1="660" x2="1120" y2="660" stroke="#FFFFFF" stroke-opacity="0.4" stroke-width="2"/>
  <line x1="1220" y1="660" x2="1220" y2="560" stroke="#FFFFFF" stroke-opacity="0.4" stroke-width="2"/>

  <!-- Top Badges -->
  <text x="70" y="110" font-family="'Space Grotesk', system-ui, sans-serif" font-size="18" font-weight="700" fill="#3B82F6" letter-spacing="4">CINEMATIC FILM</text>
  <text x="1210" y="110" font-family="'JetBrains Mono', monospace" font-size="16" fill="#94A3B8" text-anchor="end" letter-spacing="2">4K RESOLUTION // SHANMUKH AI</text>

  <!-- Bottom Editorial Typography -->
  <g transform="translate(70, 480)">
    <text x="0" y="0" font-family="'Space Grotesk', system-ui, sans-serif" font-size="48" font-weight="800" fill="#FFFFFF" letter-spacing="-1">Chronicles of 2099: Cybernetic Awakening</text>
    <text x="0" y="55" font-family="'Inter', system-ui, sans-serif" font-size="22" font-weight="400" fill="#94A3B8" letter-spacing="0.5">An AI-generated cinematic teaser featuring dynamic lighting, synthetic characters, and dramatic narrative flow.</text>
    
    <g transform="translate(0, 110)">
      <rect x="0" y="0" width="180" height="38" rx="6" fill="#171B3A" stroke="#3B82F6" stroke-width="1.5"/>
      <text x="90" y="24" font-family="'JetBrains Mono', monospace" font-size="14" font-weight="600" fill="#FFFFFF" text-anchor="middle" letter-spacing="1">CINEMATIC STILL</text>
    </g>
  </g>
</svg>